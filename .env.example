# Copie para .env (que NÃO vai para o git) só para rodar localmente.
# Em produção os valores ficam em GitHub > Settings > Secrets and variables > Actions.
# Inventário completo e escopo mínimo de cada um: docs/secrets.md

# Banco (Supabase: use a connection string do "Session pooler", IPv4)
DATABASE_URL=postgresql://garimpo_pipeline:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_USER_IDS=
APPROVAL_HMAC_SECRET=
TG_CASA_CHAT_ID=@garimpocasa
TG_PET_CHAT_ID=@garimpopet
TG_GERAL_CHAT_ID=@garimpodiario

# Shopee Affiliate Open API (deixe vazio e use mode: off + CSV manual até a API ser liberada)
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# Opcional: copy com Claude (sem isso, usa template)
ANTHROPIC_API_KEY=

# Opcional: redirecionador /go + cliques (Cloudflare Worker)
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
CF_D1_DATABASE_ID=
REDIRECT_BASE_URL=

# Backup semanal criptografado (só usado no GitHub Actions; guarde também no gerenciador de senhas)
BACKUP_PASSPHRASE=
